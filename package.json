{
  "name": "servito-main",
  "version": "1.0.0",
  "description": "Run frontend and backend together",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm start",
    "client": "cd frontend && npm run dev"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
